# Turso Cloud SQLite Database (Permanent free storage)
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here

# Super Admin Credentials (Configured via env, never hardcoded in code)
ADMIN_USERNAME=your_chosen_admin_username
ADMIN_PASSWORD=your_secure_admin_password

# Application Settings
JWT_SECRET=your-random-jwt-secret-key-change-this
PORT=3001
NODE_ENV=production
